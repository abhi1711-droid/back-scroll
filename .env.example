# Select: file (zero-config local JSON), sqlite (local relational DB), or supabase (hosted Postgres)
DATABASE_DRIVER=file

# Optional local SQLite database path (only used when DATABASE_DRIVER=sqlite)
# SQLITE_PATH=data/backscroll.sqlite

# Needed for hosted persistent storage when DATABASE_DRIVER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key

# Needed to protect /admin and its review API
ADMIN_TOKEN=replace-with-a-long-random-secret
